<!--
    深色板。键名与 Colors.Light.xaml 严格一一对应。
    强调色用 Win11 深色主题的 #60CDFF：深色背景上低饱和的亮蓝对比度最好，
    而浅色主题的 #005FB8 放在深色底上几乎看不见。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C5C5C5" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#9A9A9A" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#6B6B6B" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#000000" />

    <!-- 面 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#2D2D2D" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#323232" />

    <!-- 描边 -->
    <SolidColorBrush x:Key="BorderBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#4A4A4A" />
    <SolidColorBrush x:Key="DividerBrush" Color="#333333" />

    <!-- 强调色 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#52BFF0" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#4AA8D4" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#243447" />

    <!-- 输入控件 -->
    <SolidColorBrush x:Key="ControlFillBrush" Color="#2D2D2D" />
    <SolidColorBrush x:Key="ControlStrokeBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="ControlStrokeBottomBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="ControlFillDisabledBrush" Color="#272727" />

    <!-- 浮层（下拉、菜单） -->
    <SolidColorBrush x:Key="FlyoutBackgroundBrush" Color="#2C2C2C" />
    <SolidColorBrush x:Key="FlyoutStrokeBrush" Color="#3A3A3A" />

    <!-- 外壳分层 -->
    <SolidColorBrush x:Key="ShellGlassBrush" Color="#B3202020" />
    <SolidColorBrush x:Key="ContentGlassBrush" Color="#D92B2B2B" />

    <!-- 语义色 -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FCE100" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF99A4" />

    <!-- 云候选浮窗 -->
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="PopupStrokeBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="PopupKeyChipBrush" Color="#383838" />

    <!-- 亚克力着色：深色下压得更实，否则壁纸颜色会透上来影响 12px 说明文字 -->
    <Color x:Key="AcrylicTint">#99000000</Color>

</ResourceDictionary>
