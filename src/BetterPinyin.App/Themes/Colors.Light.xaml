<!--
    浅色板。键名与 Colors.Dark.xaml 必须严格一一对应：
    ThemeManager 在运行时整体替换本字典，任何一个键缺失都会让对应属性静默回落。

    色值取自 Windows 10/11 浅色主题的实际观感：
    窗口底色 #F3F3F3、内容面 #FDFDFD、分隔线 #E5E5E5、强调色 #005FB8。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5D5D5D" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8A8A8A" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#B5B5B5" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <!-- 面 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FDFDFD" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F7F7F7" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F0F0F0" />

    <!-- 描边 -->
    <SolidColorBrush x:Key="BorderBrush" Color="#E5E5E5" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#D1D1D1" />
    <SolidColorBrush x:Key="DividerBrush" Color="#EBEBEB" />

    <!-- 强调色 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#005FB8" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1975C5" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#004E9A" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E8F1FB" />

    <!-- 输入控件 -->
    <SolidColorBrush x:Key="ControlFillBrush" Color="#FDFDFD" />
    <SolidColorBrush x:Key="ControlStrokeBrush" Color="#D1D1D1" />
    <SolidColorBrush x:Key="ControlStrokeBottomBrush" Color="#B7B7B7" />
    <SolidColorBrush x:Key="ControlFillDisabledBrush" Color="#F3F3F3" />

    <!-- 浮层（下拉、菜单） -->
    <SolidColorBrush x:Key="FlyoutBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FlyoutStrokeBrush" Color="#E5E5E5" />

    <!-- 外壳分层：导航透出材质，内容区接近不透明保证长文本可读 -->
    <SolidColorBrush x:Key="WindowGlassBrush" Color="#99F5F5F5" />
    <SolidColorBrush x:Key="ShellGlassBrush" Color="#B3F3F3F3" />
    <SolidColorBrush x:Key="ContentGlassBrush" Color="#D9FDFDFD" />

    <!-- 语义色 -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#0F7B0F" />
    <SolidColorBrush x:Key="WarningBrush" Color="#9D5D00" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C" />

    <!-- 云候选浮窗 -->
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PopupStrokeBrush" Color="#D8DDE5" />
    <SolidColorBrush x:Key="PopupKeyChipBrush" Color="#F1F3F6" />

    <!-- 亚克力着色（Win10 路径用；Win11 由系统按主题着色，不读这个值） -->
    <Color x:Key="AcrylicTint">#73FFFFFF</Color>

</ResourceDictionary>
