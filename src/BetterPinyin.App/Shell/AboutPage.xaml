<Page ScrollViewer.CanContentScroll="False" x:Class="BetterPinyin.App.Shell.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fl="http://schemas.lepo.co/wpfui/2022/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI">

    <ScrollViewer x:Name="RootScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="{DynamicResource PageMaxWidth}"
                    Margin="{DynamicResource PagePadding}"
                    HorizontalAlignment="Left">

            <TextBlock Text="关于" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4"
                       Text="为 Windows 自带的微软拼音补充云联想能力的伴随程序。不替换输入法、不修改输入法本体，原有候选、快捷键与学习行为保持不变。" />

            <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 默认显示应用图标，鼠标移入淡入主视觉，移出再淡回。
                         两张图叠在一起做交叉淡入，避免切换时闪一下空白。 -->
                    <Border x:Name="LogoBox"
                            Width="168"
                            Height="168"
                            Margin="0,0,24,0"
                            Background="Transparent"
                            Cursor="Hand"
                            AutomationProperties.Name="应用图标，鼠标移入可查看主视觉"
                            MouseEnter="OnLogoEnter"
                            MouseLeave="OnLogoLeave">
                        <Grid>
                            <Image x:Name="HeroImage"
                                   Source="pack://application:,,,/assets/brand/logo0.png"
                                   Stretch="Uniform"
                                   Opacity="0"
                                   IsHitTestVisible="False"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <Image x:Name="IconImage"
                                   Source="pack://application:,,,/assets/brand/logo1.png"
                                   Stretch="Uniform"
                                   Opacity="1"
                                   IsHitTestVisible="False"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="更好的微软拼音"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Better Microsoft Pinyin"
                                   FontSize="13"
                                   Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="AboutVersionText"
                                   FontSize="12"
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                        <Border Height="1"
                                Margin="0,14,0,12"
                                Background="{DynamicResource BorderBrush}" />

                        <TextBlock Style="{StaticResource Hint}" FontSize="13" LineHeight="22">
                            <Run Text="作者：" />
                            <Hyperlink NavigateUri="https://github.com/Yuooms"
                                       RequestNavigate="OnLinkClick"
                                       Foreground="{DynamicResource AccentBrush}"
                                       ToolTip="在浏览器中打开 GitHub 主页">Yuooms</Hyperlink>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Hint}" FontSize="13" LineHeight="22" Margin="0,6,0,0">
                            <Run Text="项目地址：" />
                            <Hyperlink NavigateUri="https://github.com/Yuooms/better-microsoft-pinyin"
                                       RequestNavigate="OnLinkClick"
                                       Foreground="{DynamicResource AccentBrush}"
                                       ToolTip="在浏览器中打开项目主页">https://github.com/Yuooms/better-microsoft-pinyin</Hyperlink>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Hint}" FontSize="13" LineHeight="22" Margin="0,6,0,0">
                            <Run Text="开源协议：" />
                            <Hyperlink NavigateUri="https://opensource.org/license/mit"
                                       RequestNavigate="OnLinkClick"
                                       Foreground="{DynamicResource AccentBrush}"
                                       ToolTip="查看 MIT 许可证原文">MIT License</Hyperlink>
                            <Run Text="，可自由使用、修改与再分发，请保留版权与许可声明。" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Hint}" FontSize="13" LineHeight="22" Margin="0,6,0,0"
                                   Text="第三方组件（WPF-UI、pinyin-data 等）的版权声明见仓库根目录的 THIRD-PARTY-NOTICES.md。" />
                        <TextBlock Style="{StaticResource Hint}" FontSize="13" LineHeight="22" Margin="0,6,0,0"
                                   Text="本项目是非官方第三方工具，与 Microsoft Corporation 无隶属关系。" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="更新" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}" Padding="16,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock x:Name="UpdateTitleText"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Text="检查 GitHub 上的最新发布" />
                            <TextBlock x:Name="UpdateStatusText"
                                       Style="{StaticResource Hint}"
                                       FontSize="13"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Text="只读公开发布的版本号与发布时间，不上报任何本机信息。" />
                        </StackPanel>

                        <fl:Button Grid.Column="1"
                                   x:Name="CheckUpdateButton"
                                   Content="检查更新"
                                   MinWidth="96"
                                   VerticalAlignment="Top"
                                   Click="OnCheckUpdateClick" />
                    </Grid>

                    <!-- 只有真的发现新版本才露出来，平时不占视觉空间 -->
                    <StackPanel x:Name="UpdateActionsPanel"
                                Orientation="Horizontal"
                                Margin="0,12,0,0"
                                Visibility="Collapsed">
                        <fl:Button x:Name="InstallUpdateButton"
                                   Content="下载并安装"
                                   Appearance="Primary"
                                   MinWidth="110"
                                   Click="OnInstallUpdateClick" />
                        <fl:Button Content="打开发布页"
                                   MinWidth="110"
                                   Margin="8,0,0,0"
                                   Click="OnOpenReleaseClick" />
                    </StackPanel>

                    <ProgressBar x:Name="UpdateProgressBar"
                                 Height="4"
                                 Margin="0,10,0,0"
                                 Minimum="0"
                                 Maximum="1"
                                 Visibility="Collapsed" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <fl:ToggleSwitch x:Name="UpdateAutoCheckSwitch"
                                         Checked="OnAutoCheckChanged"
                                         Unchecked="OnAutoCheckChanged" />
                        <TextBlock Style="{StaticResource Hint}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                                   Text="启动时自动检查更新（每天最多一次）" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="隐私" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}" Padding="16,14">
                <TextBlock Style="{StaticResource Hint}" FontSize="13" LineHeight="22"
                           Text="只把当前输入串发给你选择使用的搜索建议接口，不发送正在输入的应用名、上下文或任何可识别身份的信息。配置与日志全部保存在本机。" />
            </Border>

            <TextBlock Text="工作方式" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}" Padding="16,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource Hint}" FontSize="13" LineHeight="22"
                               Text="1. 通过系统级键盘钩子感知按键，重建你正在输入的拼音串。" />
                    <TextBlock Style="{StaticResource Hint}" FontSize="13" LineHeight="22" Margin="0,6,0,0"
                               Text="2. 停手后向搜索建议接口查询，用读音规则过滤掉对不上的结果。" />
                    <TextBlock Style="{StaticResource Hint}" FontSize="13" LineHeight="22" Margin="0,6,0,0"
                               Text="3. 候选窗旁弹出浮窗显示云词，按采纳键后取消组字并上屏。" />
                </StackPanel>
            </Border>

            <TextBlock Text="已知限制" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}" Padding="16,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource Hint}" FontSize="13" LineHeight="22"
                               Text="• 以管理员身份运行的程序里无法上屏（系统权限隔离）。" />
                    <TextBlock Style="{StaticResource Hint}" FontSize="13" LineHeight="22" Margin="0,6,0,0"
                               Text="• 全屏独占游戏与部分反作弊环境不支持。" />
                    <TextBlock Style="{StaticResource Hint}" FontSize="13" LineHeight="22" Margin="0,6,0,0"
                               Text="• 纯缩写（如 ystl）依赖内置词库展开，未收录的专名命中率有限。" />
                    <TextBlock Style="{StaticResource Hint}" FontSize="13" LineHeight="22" Margin="0,6,0,0"
                               Text="• 托盘右键菜单由系统绘制，深色主题下仍为浅色。" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
