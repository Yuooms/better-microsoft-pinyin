<ui:FluentWindow x:Class="BetterPinyin.App.Shell.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Better 微软拼音"
                 Icon="pack://application:,,,/assets/brand/app.ico"
                 Width="1080"
                 Height="720"
                 MinWidth="900"
                 MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 Background="Transparent"
                 FontFamily="Microsoft YaHei UI, Segoe UI">

    <!--
        标题栏与导航都由 WPF-UI 绘制：
        - FluentWindow 内部设置 WindowChrome（CaptionHeight=0、ResizeBorderThickness=4），
          TitleBar 自己处理 WM_NCHITTEST，不要再叠加 DwmExtendFrameIntoClientArea。
        - 材质走 WPF-UI 的 WindowBackdropType（见 SettingsWindow.RefreshWindowMaterial）：
          Windows 11 22H2 及以上设 Mica，其余保持 None 并用纯色底。
          材质打开时窗口背景是透明的，可读性靠最底下那层 MaterialTint 着色。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 材质着色层：在窗口透明背景之上、内容之下。纯色模式下整层隐藏。 -->
        <Border x:Name="MaterialTint"
                Grid.RowSpan="2"
                Background="{DynamicResource WindowGlassBrush}"
                IsHitTestVisible="False"
                Visibility="Collapsed" />

        <!-- 背景图：在窗口底色之上、标题栏与内容之下；不参与命中测试。 -->
        <Image x:Name="BackgroundImage"
               Grid.RowSpan="2"
               Stretch="UniformToFill"
               IsHitTestVisible="False"
               RenderOptions.BitmapScalingMode="HighQuality"
               Visibility="Collapsed" />

        <ui:TitleBar Grid.Row="0"
                     Height="48"
                     Title="Better 微软拼音">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/assets/brand/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:NavigationView x:Name="RootNavigation"
                           Grid.Row="1"
                           Background="Transparent"
                           OpenPaneLength="160"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           IsTopSeparatorVisible="False">
            <ui:NavigationView.PaneHeader>
                <StackPanel Margin="16,10,16,6">
                    <ui:TextBlock Text="Better 微软拼音"
                                  FontTypography="Caption"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  TextTrimming="CharacterEllipsis" />
                    <ui:TextBlock x:Name="VersionText"
                                  FontTypography="Caption"
                                  Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </ui:NavigationView.PaneHeader>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
