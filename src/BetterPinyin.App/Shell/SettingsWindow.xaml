<Window x:Class="BetterPinyin.App.Shell.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Better 微软拼音 · 设置"
        Width="940" Height="660"
        MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <!-- 使用系统标题栏：控件与外观都交给 Windows，不自绘 -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧导航：半透明，透出系统亚克力；内容区接近不透明以保证可读 -->
        <Border Background="#1FFFFFFF" BorderBrush="#22000000" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,18,20,12">
                    <TextBlock Text="Better 微软拼音" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                </StackPanel>

                <ListBox x:Name="NavList"
                         DockPanel.Dock="Top"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectionChanged="OnNavSelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,7" />
                            <Setter Property="Margin" Value="8,1" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Root" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="#22000000" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 右侧内容区：接近不透明，长文本在浅色壁纸上也能看清 -->
        <Border Grid.Column="1" Background="#F7FFFFFF">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,16,20">
                <ContentControl x:Name="ContentHost" />
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
