<UserControl x:Class="BetterPinyin.App.Shell.NetworkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="{DynamicResource PageMaxWidth}"
                    Margin="{DynamicResource PagePadding}"
                    HorizontalAlignment="Left">

            <TextBlock Text="网络与环境" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4"
                       Text="同一份程序要能在不同网络环境下工作，因此不写死任何地区假设：启动时探测各端点，按实测结果选择。" />

            <TextBlock Text="环境自检" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}" Padding="12">
                <StackPanel x:Name="EnvironmentPanel" />
            </Border>

            <TextBlock Text="端点体检" Style="{StaticResource SectionTitle}" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                       Text="点击检测会对每个端点发起一次真实查询：只有 HTTP 成功且能解析出候选才算通过，仅仅「能连上」不算。" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="ProbeButton" Content="重新检测" Click="OnProbeClick" />
                <TextBlock x:Name="ProbeStatusText" VerticalAlignment="Center" Margin="12,0,0,0"
                           Style="{StaticResource Hint}" />
            </StackPanel>

            <Border Style="{StaticResource Card}" Padding="12">
                <StackPanel x:Name="EndpointPanel">
                    <TextBlock Text="尚未检测。点击「重新检测」会对每个端点发起一次真实查询。"
                               Style="{StaticResource Hint}" />
                </StackPanel>
            </Border>

            <TextBlock Text="当前生效设置" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}" Padding="12">
                <StackPanel x:Name="SettingsPanel" />
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
