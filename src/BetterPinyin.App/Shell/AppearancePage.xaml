<UserControl x:Class="BetterPinyin.App.Shell.AppearancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:BetterPinyin.App.Shell.Controls"
             FontFamily="Microsoft YaHei UI, Segoe UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="{DynamicResource PageMaxWidth}"
                    Margin="{DynamicResource PagePadding}"
                    HorizontalAlignment="Left">

            <TextBlock Text="外观" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4"
                       Text="选择配色与窗口背景。改动立即生效，不需要保存。" />

            <TextBlock Text="主题" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <HeaderedContentControl Style="{StaticResource SettingRow}"
                                            Header="配色模式"
                                            ui:SettingRow.Description="跟随系统会读取 Windows 的「应用模式」设置，并在系统切换时自动跟随。"
                                            ui:SettingRow.ShowDivider="False">
                        <ComboBox x:Name="ThemeComboBox" Width="200" SelectionChanged="OnThemeSelectionChanged">
                            <ComboBoxItem Content="跟随系统" Tag="System" />
                            <ComboBoxItem Content="浅色" Tag="Light" />
                            <ComboBoxItem Content="深色" Tag="Dark" />
                        </ComboBox>
                    </HeaderedContentControl>
                </StackPanel>
            </Border>

            <TextBlock Text="窗口" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <HeaderedContentControl Style="{StaticResource SettingRow}"
                                            Header="窗口背景"
                                            ui:SettingRow.Description="自动：Windows 11 使用系统材质，Windows 10 使用纯色。亚克力在 Windows 10 上会让拖动窗口掉帧。"
                                            ui:SettingRow.ShowDivider="False">
                        <ComboBox x:Name="BackdropComboBox" Width="200" SelectionChanged="OnBackdropSelectionChanged">
                            <ComboBoxItem Content="自动" Tag="Auto" />
                            <ComboBoxItem Content="纯色" Tag="Solid" />
                            <ComboBoxItem Content="亚克力" Tag="Acrylic" />
                        </ComboBox>
                    </HeaderedContentControl>
                </StackPanel>
            </Border>

            <TextBlock Text="预览" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <HeaderedContentControl Style="{StaticResource SettingRow}"
                                            Header="开关与按钮的外观"
                                            ui:SettingRow.Description="这一行就是设置页里每一项的实际样式。">
                        <CheckBox IsChecked="True" IsHitTestVisible="False" Focusable="False" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource SettingRow}"
                                            Header="次要按钮"
                                            ui:SettingRow.Description="用于「重新检测」这类不改变设置的操作。"
                                            ui:SettingRow.ShowDivider="False">
                        <Button Content="示例" IsHitTestVisible="False" Focusable="False" />
                    </HeaderedContentControl>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Hint}" Margin="0,16,0,0"
                       Text="说明：标题栏、滚动条与托盘右键菜单由 Windows 绘制；其余控件按当前系统版本的尺寸与配色绘制。" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
