<Page x:Class="BetterPinyin.App.Shell.GeneralPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="clr-namespace:BetterPinyin.App.Shell.Controls"
      xmlns:fl="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="False"
      FontFamily="Microsoft YaHei UI, Segoe UI"
      Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="{DynamicResource PageMaxWidth}"
                    Margin="{DynamicResource PagePadding}"
                    HorizontalAlignment="Left">

            <fl:TextBlock Text="常规" FontTypography="Title" />
            <fl:TextBlock FontTypography="Caption"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Margin="0,4,0,0"
                          TextWrapping="Wrap"
                          Text="启动方式。改动立即生效，不需要保存。" />

            <fl:TextBlock Text="启动" FontTypography="BodyStrong" Margin="0,20,0,8" />
            <Border Style="{StaticResource Card}">
                <HeaderedContentControl Style="{StaticResource SettingRow}"
                                        Header="开机启动"
                                        ui:SettingRow.Description="登录 Windows 后自动在后台运行，只在托盘显示图标，不弹设置窗口。只写当前用户的启动项，不需要管理员权限。"
                                        ui:SettingRow.ShowDivider="False">
                    <fl:ToggleSwitch x:Name="StartupToggle"
                                     AutomationProperties.Name="开机启动"
                                     Checked="OnStartupToggled"
                                     Unchecked="OnStartupToggled" />
                </HeaderedContentControl>
            </Border>

            <TextBlock x:Name="StatusText"
                       Margin="2,10,0,0"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <fl:TextBlock Text="说明" FontTypography="BodyStrong" Margin="0,20,0,8" />
            <Border Style="{StaticResource Card}" Padding="16,14">
                <StackPanel>
                    <TextBlock FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="登记位置是 HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Run，值名为 BetterMicrosoftPinyin。不创建计划任务，也不写系统级启动项。" />
                    <TextBlock FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="如果程序被移动或重新发布到别的目录，下次从新位置启动时会自动把登记路径改过来，不会留下指向旧位置的启动项。" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
