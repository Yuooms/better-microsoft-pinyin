<Page x:Class="BetterPinyin.App.Shell.GeneralPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="clr-namespace:BetterPinyin.App.Shell.Controls"
      xmlns:fl="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="False"
      FontFamily="Microsoft YaHei UI, Segoe UI"
      Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="{DynamicResource PageMaxWidth}"
                    Margin="{DynamicResource PagePadding}"
                    HorizontalAlignment="Left">

            <fl:TextBlock Text="常规" FontTypography="Title" />
            <fl:TextBlock FontTypography="Caption"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Margin="0,4,0,0"
                          TextWrapping="Wrap"
                          Text="启动方式。改动立即生效，不需要保存。" />

            <fl:TextBlock Text="启动" FontTypography="BodyStrong" Margin="0,20,0,8" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <HeaderedContentControl Style="{StaticResource SettingRow}"
                                            Header="开机启动"
                                            ui:SettingRow.Description="登录 Windows 后自动在后台运行，只在托盘显示图标，不弹设置窗口。">
                        <fl:ToggleSwitch x:Name="StartupToggle"
                                         AutomationProperties.Name="开机启动"
                                         Checked="OnStartupToggled"
                                         Unchecked="OnStartupToggled" />
                    </HeaderedContentControl>

                    <HeaderedContentControl Style="{StaticResource SettingRow}"
                                            Header="以管理员身份启动"
                                            ui:SettingRow.ShowDivider="False"
                                            ui:SettingRow.Description="开机后以管理员权限静默运行，这样在以管理员权限运行的程序里也能用云联想。开启和关闭各需要一次管理员确认。">
                        <fl:ToggleSwitch x:Name="ElevatedStartupToggle"
                                         AutomationProperties.Name="以管理员身份启动"
                                         Checked="OnElevatedStartupToggled"
                                         Unchecked="OnElevatedStartupToggled" />
                    </HeaderedContentControl>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText"
                       Margin="2,10,0,0"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <fl:TextBlock Text="说明" FontTypography="BodyStrong" Margin="0,20,0,8" />
            <Border Style="{StaticResource Card}" Padding="16,14">
                <StackPanel>
                    <TextBlock FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="普通方式的登记位置是 HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Run，值名为 BetterMicrosoftPinyin，不需要管理员权限。" />
                    <TextBlock FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="打开「以管理员身份启动」后改用计划任务（RunLevel=HighestAvailable），注册表里的那一项会被移除，两者不会同时存在。只有计划任务能在登录时静默提权——注册表启动项拉起的进程永远是普通权限。" />
                    <TextBlock FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="如果程序被移动或重新发布到别的目录，下次从新位置启动时会自动改正注册表方式的登记路径；计划任务需要在这里关闭再开启一次。" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
