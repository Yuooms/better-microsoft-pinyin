<Page ScrollViewer.CanContentScroll="False" x:Class="BetterPinyin.App.Features.Statistics.Views.StatisticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="clr-namespace:BetterPinyin.App.Shell.Controls"
      xmlns:fl="http://schemas.lepo.co/wpfui/2022/xaml"
      FontFamily="Microsoft YaHei UI, Segoe UI">

    <DockPanel>
        <!-- 没有保存按钮：开关与保留期都即时生效，这里只留状态提示 -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="42,12">
            <TextBlock x:Name="SaveStatusText"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       Text="改动会立即生效并自动保存" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="820"
                        Margin="42,20,42,28"
                        HorizontalAlignment="Left">

                <fl:TextBlock Text="输入统计" FontTypography="Title" />
                <fl:TextBlock FontTypography="Caption"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              TextWrapping="Wrap"
                              Margin="0,4,0,0"
                              Text="只保存在这台电脑上，不联网、不上传，也不记录你打了什么字。统计的是「本程序观测到的输入」，关掉本程序的托盘图标后不再累计。" />

                <TextBlock x:Name="WarningText"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           Foreground="{DynamicResource WarningBrush}" />

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <HeaderedContentControl Style="{StaticResource SettingRow}"
                                                Header="在本机记录输入统计"
                                                ui:SettingRow.Description="默认关闭。打开后从下一次按键开始累计；关闭只是停止记录，已有历史仍会保留，可以随时清空。">
                            <fl:ToggleSwitch x:Name="EnabledToggle"
                                             AutomationProperties.Name="在本机记录输入统计"
                                             Checked="OnEnabledChanged"
                                             Unchecked="OnEnabledChanged" />
                        </HeaderedContentControl>

                        <HeaderedContentControl Style="{StaticResource SettingRow}"
                                                Header="按程序分别统计"
                                                ui:SettingRow.Description="会记录输入发生在哪个程序（只记进程名，不记窗口标题与文件路径）。关闭后只累计总数。"
                                                ui:SettingRow.ShowDivider="False">
                            <fl:ToggleSwitch x:Name="PerAppToggle"
                                             AutomationProperties.Name="按程序分别统计"
                                             Checked="OnEnabledChanged"
                                             Unchecked="OnEnabledChanged" />
                        </HeaderedContentControl>
                    </StackPanel>
                </Border>

                <fl:TextBlock Text="今天" FontTypography="BodyStrong" Margin="0,20,0,8" />
                <UniformGrid x:Name="TodayGrid" Columns="4" />

                <fl:TextBlock Text="趋势" FontTypography="BodyStrong" Margin="0,20,0,8" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ComboBox x:Name="RangeCombo" Width="140" SelectionChanged="OnRangeChanged">
                                <ComboBoxItem Content="今天" Tag="today" />
                                <ComboBoxItem Content="近 7 天" Tag="7" />
                                <ComboBoxItem Content="近 30 天" Tag="30" />
                                <ComboBoxItem Content="本月" Tag="month" />
                            </ComboBox>
                            <ComboBox x:Name="MetricCombo" Width="150" Margin="10,0,0,0" SelectionChanged="OnRangeChanged">
                                <ComboBoxItem Content="组字次数" Tag="compositions" />
                                <ComboBoxItem Content="拼音字母数" Tag="letters" />
                            </ComboBox>
                        </StackPanel>

                        <Grid Height="184">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 纵轴：只标 0、一半、最大值。标签与柱子的绘图区同高（150），
                                 这样顶部标签就落在柱子上限的水平线上。 -->
                            <Grid Grid.Column="0"
                                  Width="28"
                                  Height="150"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Top">
                                <TextBlock x:Name="AxisMaxText"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Top"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="AxisMidText"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="0"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Grid>

                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="150" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- 三条刻度线：顶=最大值、中=一半、底=0。
                                     不参与命中测试，免得挡住柱子的提示。 -->
                                <Grid Grid.Row="0" IsHitTestVisible="False">
                                    <Rectangle Height="1" VerticalAlignment="Top"
                                               Fill="{DynamicResource BorderBrush}" />
                                    <Rectangle Height="1" VerticalAlignment="Center"
                                               Fill="{DynamicResource BorderBrush}" />
                                    <Rectangle Height="1" VerticalAlignment="Bottom"
                                               Fill="{DynamicResource BorderBrush}" />
                                </Grid>

                                <ItemsControl x:Name="ChartItems" Grid.Row="0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="3,0">
                                                <Rectangle Height="{Binding BarHeight}"
                                                           Width="20"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Bottom"
                                                           RadiusX="3"
                                                           RadiusY="3"
                                                           Fill="{DynamicResource AccentBrush}"
                                                           ToolTip="{Binding Tooltip}"
                                                           ToolTipService.InitialShowDelay="0"
                                                           ToolTipService.BetweenShowDelay="0"
                                                           ToolTipService.ShowDuration="60000" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="EmptyText"
                                           Grid.Row="0"
                                           Text="这段时间还没有记录。打几个字试试。"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                <!-- X 轴标签单独一行，与柱子共用 UniformGrid 的列宽，
                                     这样绘图区可以严格等于 150px，纵轴刻度才对得上。 -->
                                <ItemsControl x:Name="ChartLabels" Grid.Row="1">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}"
                                                       FontSize="10"
                                                       Margin="3,6,3,0"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>

                        <TextBlock x:Name="ChartHint"
                                   Margin="0,10,0,0"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <fl:TextBlock Text="程序排行" FontTypography="BodyStrong" Margin="0,20,0,8" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <ItemsControl x:Name="AppItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   ToolTip="{Binding Name}" />
                                        <Border Grid.Column="1"
                                                Height="8"
                                                Width="420"
                                                HorizontalAlignment="Left"
                                                CornerRadius="4"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                VerticalAlignment="Center">
                                            <Border Width="{Binding BarWidth}"
                                                    CornerRadius="4"
                                                    HorizontalAlignment="Left"
                                                    Background="{DynamicResource AccentBrush}" />
                                        </Border>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Value}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="AppEmptyText"
                                   Text="还没有按程序统计的数据。"
                                   Visibility="Collapsed"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <fl:TextBlock Text="数据" FontTypography="BodyStrong" Margin="0,20,0,8" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <HeaderedContentControl Style="{StaticResource SettingRow}"
                                                Header="保留期"
                                                ui:SettingRow.Description="超出后会在下次写入时自动裁掉最旧的日子。只统计有记录的日子，不会因为一段时间没用就清空历史。">
                            <ComboBox x:Name="RetentionCombo" Width="160" SelectionChanged="OnRetentionChanged">
                                <ComboBoxItem Content="最近 30 天" Tag="30" />
                                <ComboBoxItem Content="最近 90 天" Tag="90" />
                                <ComboBoxItem Content="最近一年" Tag="365" />
                                <ComboBoxItem Content="永久保留" Tag="0" />
                            </ComboBox>
                        </HeaderedContentControl>

                        <HeaderedContentControl Style="{StaticResource SettingRow}"
                                                Header="清空全部历史"
                                                ui:SettingRow.Description="删除本机所有统计记录，不可撤销，也不会保留备份。设置与词库不受影响。">
                            <fl:Button Content="清空…"
                                       Appearance="Danger"
                                       Click="OnClearClick" />
                        </HeaderedContentControl>

                        <HeaderedContentControl Style="{StaticResource SettingRow}"
                                                Header="数据文件"
                                                ui:SettingRow.ShowDivider="False">
                            <TextBlock x:Name="DataInfoText"
                                       TextWrapping="Wrap"
                                       MaxWidth="420"
                                       HorizontalAlignment="Right"
                                       TextAlignment="Right"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </HeaderedContentControl>
                    </StackPanel>
                </Border>

                <fl:TextBlock FontTypography="Caption"
                              Margin="0,16,0,0"
                              TextWrapping="Wrap"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text="口径说明：这里统计的是本程序通过键盘钩子观测到的输入，不是输入法自己的统计。微软拼音把汉字提交在目标程序的进程里，外部读不到，所以「上屏字数」只能统计云联想采纳的那部分，普通输入只记组字次数与拼音字母数。" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Page>
