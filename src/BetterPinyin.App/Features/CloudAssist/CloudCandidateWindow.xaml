<Window x:Class="BetterPinyin.App.Features.CloudAssist.CloudCandidateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="云候选"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        IsHitTestVisible="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <!--
        浮窗刻意不使用任何可交互控件：
        它永远不该拿到焦点，否则输入法会立即提交组字，用户还没按采纳键拼音就上屏了。
    -->
    <Border x:Name="Card"
            Background="#FFFFFF"
            BorderBrush="#D8DDE5"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,7"
            Margin="6"
            HorizontalAlignment="Left">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.16" Color="#000000" />
        </Border.Effect>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="CloudGlyph"
                       Text="&#xE753;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="13"
                       Foreground="#0F6CBD"
                       VerticalAlignment="Center"
                       Margin="0,0,7,0" />
            <TextBlock x:Name="CandidateText"
                       Text="候选词"
                       FontFamily="Microsoft YaHei UI"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="#1F2328"
                       VerticalAlignment="Center" />
            <Border Background="#F1F3F6"
                    CornerRadius="4"
                    Padding="5,1"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center">
                <TextBlock x:Name="KeyHint"
                           Text="Tab"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           Foreground="#6B7280" />
            </Border>
        </StackPanel>
    </Border>
</Window>
