<Window x:Class="BetterPinyin.App.Features.CloudAssist.CloudCandidateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="云候选"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        IsHitTestVisible="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <!--
        三条硬约束，任何一条被破坏都会毁掉输入体验：
        1. 绝不抢焦点：WS_EX_NOACTIVATE + ShowActivated=False。
        2. 不挡鼠标：WS_EX_TRANSPARENT + IsHitTestVisible=False。
        3. 不遮候选条：候选条在沉浸式 IME 图层，永远在我们上方，只能贴边显示。
    -->
    <Border x:Name="Card"
            Background="#FFFFFF"
            BorderBrush="#D8DDE5"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,6"
            Margin="6"
            MaxWidth="380">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.16" Color="#000000" />
        </Border.Effect>

        <ItemsControl x:Name="Rows" IsHitTestVisible="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="&#xE753;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   Foreground="#0F6CBD"
                                   Opacity="{Binding IconOpacity}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,7,0" />

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Text}"
                                   FontFamily="Microsoft YaHei UI"
                                   FontSize="{Binding TextSize}"
                                   FontWeight="{Binding TextWeight}"
                                   Foreground="#1F2328"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />

                        <Border Grid.Column="2"
                                Background="#F1F3F6"
                                CornerRadius="4"
                                Padding="5,1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding KeyLabel}"
                                       FontFamily="Segoe UI"
                                       FontSize="11"
                                       Foreground="#6B7280" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</Window>
