<Window x:Class="BetterPinyin.App.Features.CloudAssist.CloudCandidateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="云候选"
        Style="{x:Null}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        IsHitTestVisible="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <!--
            WPF-UI 带一个应用级的隐式 Window 样式（WindowStyle=SingleBorderWindow、
            AllowsTransparency=False，并替换窗口模板），会把无焦点浮窗直接毁掉。
            Style="{x:Null}" 是首选；这里再放一个本地空样式，防止某些版本上它被忽略。
        -->
        <Style TargetType="{x:Type Window}" />

        <!-- 纯白卡片：圆角 + 大软阴影，贴近 Win11 输入法的候选条。 -->
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="14"
                          ShadowDepth="2"
                          Direction="270"
                          Opacity="0.16"
                          Color="#000000" />

        <!-- 经典：直角 + 更小更实的阴影，贴近 Win10 输入法的候选条。 -->
        <DropShadowEffect x:Key="ClassicShadow"
                          BlurRadius="8"
                          ShadowDepth="2"
                          Direction="270"
                          Opacity="0.14"
                          Color="#000000" />
    </Window.Resources>

    <!--
        三条硬约束，任何一条被破坏都会毁掉输入体验：
        1. 绝不抢焦点：WS_EX_NOACTIVATE + ShowActivated=False。
        2. 不挡鼠标：WS_EX_TRANSPARENT + IsHitTestVisible=False。
        3. 不遮候选条：候选条在沉浸式 IME 图层，永远在我们上方，只能贴边显示。

        两种样式都走分层窗口（AllowsTransparency=True），圆角与阴影完全由 WPF 绘制，
        不再申请 DWM 材质——非分层窗口的系统圆角和 WPF 描边对不齐时，
        会露出「圆角但圆角外不透明」的硬边，观感比实色更差。
    -->
    <Border x:Name="Card"
            Background="{DynamicResource PopupBackgroundBrush}"
            BorderBrush="{DynamicResource PopupStrokeBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,6"
            Margin="6"
            MaxWidth="380"
            Effect="{StaticResource CardShadow}">

        <ItemsControl x:Name="Rows" IsHitTestVisible="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="&#xE753;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Opacity="{Binding IconOpacity}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,7,0" />

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Text}"
                                   FontFamily="Microsoft YaHei UI"
                                   FontSize="{Binding TextSize}"
                                   FontWeight="{Binding TextWeight}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />

                        <Border Grid.Column="2"
                                Background="{DynamicResource PopupKeyChipBrush}"
                                CornerRadius="4"
                                Padding="5,1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding KeyLabel}"
                                       FontFamily="Segoe UI"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</Window>
