<Page ScrollViewer.CanContentScroll="False" x:Class="BetterPinyin.App.Features.CloudAssist.Views.CloudAssistPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="clr-namespace:BetterPinyin.App.Shell.Controls"
      xmlns:fl="http://schemas.lepo.co/wpfui/2022/xaml"
      FontFamily="Microsoft YaHei UI, Segoe UI">

    <DockPanel>
        <!-- 保存条固定在底部：页面再长也不用滚到底才能保存 -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="42,12">
            <StackPanel Orientation="Horizontal">
                <fl:Button x:Name="SaveButton"
                           Content="保存并应用"
                           Appearance="Primary"
                           MinWidth="120"
                           Click="OnSaveClick" />
                <fl:Button Content="恢复默认"
                           Appearance="Secondary"
                           MinWidth="100"
                           Margin="8,0,0,0"
                           Click="OnResetClick" />
                <TextBlock x:Name="SaveStatusText"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="820"
                        Margin="42,20,42,28"
                        HorizontalAlignment="Left">

                <fl:TextBlock Text="云联想" FontTypography="Title" />
                <fl:TextBlock FontTypography="Caption"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              TextWrapping="Wrap"
                              Margin="0,4,0,0"
                              Text="输入拼音时从 Bing 取联想词。云联想严格按字数匹配，扩展云联想补充更长的词，两者可独立开关。" />

                <!-- 总开关单独一张卡，对应系统设置里的「主开关」 -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <HeaderedContentControl Style="{StaticResource SettingRow}"
                                            Header="启用云联想"
                                            ui:SettingRow.Description="关闭后不查询云端，但仍保留托盘图标与设置界面。"
                                            ui:SettingRow.ShowDivider="False">
                        <fl:ToggleSwitch x:Name="EnabledCheckBox"
                                         AutomationProperties.Name="启用云联想" />
                    </HeaderedContentControl>
                </Border>

                <fl:TextBlock Text="云联想" FontTypography="BodyStrong" Margin="0,20,0,8" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <HeaderedContentControl Style="{StaticResource SettingRow}"
                                                Header="启用云联想"
                                                ui:SettingRow.Description="候选必须与输入的字数完全相等。例如 lianxiang 只会给出「联想」，不会给出「联想电脑管家」。">
                            <fl:ToggleSwitch x:Name="StrictCheckBox"
                                             AutomationProperties.Name="启用云联想" />
                        </HeaderedContentControl>

                        <HeaderedContentControl Style="{StaticResource SettingRow}"
                                                Header="采纳键"
                                                ui:SettingRow.Description="点一下方框，然后按下想用的键。字母、空格、回车不能用；Tab 会调出 Bing 搜索，数字会盖过输入法同号候选。">
                            <ui:KeyCaptureBox x:Name="StrictKeyBox" Width="220" />
                        </HeaderedContentControl>

                        <HeaderedContentControl Style="{StaticResource SettingRow}"
                                                Header="候选已在本地候选里时不显示"
                                                ui:SettingRow.Description="本地已经能选到的词不再重复展示，避免云联想没有带来新信息。"
                                                ui:SettingRow.ShowDivider="False">
                            <fl:ToggleSwitch x:Name="StrictDedupeCheckBox"
                                             AutomationProperties.Name="候选已在本地候选里时不显示" />
                        </HeaderedContentControl>
                    </StackPanel>
                </Border>

                <fl:TextBlock Text="扩展云联想" FontTypography="BodyStrong" Margin="0,20,0,8" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <HeaderedContentControl Style="{StaticResource SettingRow}"
                                                Header="启用扩展云联想"
                                                ui:SettingRow.Description="补充以当前拼音开头的更长词。例如 ruonawa 会补充「若娜瓦壁纸」「若娜瓦英文」。">
                            <fl:ToggleSwitch x:Name="ExtendedCheckBox"
                                             AutomationProperties.Name="启用扩展云联想" />
                        </HeaderedContentControl>

                        <HeaderedContentControl Style="{StaticResource SettingRow}"
                                                Header="显示条数"
                                                ui:SettingRow.Description="手动指定时这一项跟着采纳键的个数走：有几个键就能显示几条。">
                            <ComboBox x:Name="ExtendedCountComboBox" Width="100">
                                <ComboBoxItem Content="1 条" Tag="1" />
                                <ComboBoxItem Content="2 条" Tag="2" />
                                <ComboBoxItem Content="3 条" Tag="3" />
                                <ComboBoxItem Content="4 条" Tag="4" />
                            </ComboBox>
                        </HeaderedContentControl>

                        <HeaderedContentControl Style="{StaticResource SettingRow}"
                                                Header="键位分配"
                                                ui:SettingRow.Description="自动模式：本地候选显示 5 个时，扩展用 6/7/8；读不到候选数时退回 6/7/8 并在提交前复核。">
                            <ComboBox x:Name="ExtendedKeyModeComboBox" Width="220"
                                      SelectionChanged="OnKeyModeChanged">
                                <ComboBoxItem Content="自动：接在本地候选之后" Tag="Auto" />
                                <ComboBoxItem Content="手动指定" Tag="Manual" />
                            </ComboBox>
                        </HeaderedContentControl>

                        <HeaderedContentControl Style="{StaticResource SettingRow}"
                                                Header="采纳键"
                                                ui:SettingRow.Description="点「添加按键」后直接按键；拖动左侧手柄调整顺序。第 1 个键对应浮窗第 1 行，最多 4 个。只在「手动指定」下可以编辑。"
                                                ui:SettingRow.ShowDivider="False">
                            <StackPanel Width="260">
                                <!-- 自动模式下整块压暗并禁用（见 UpdateKeyModeState）：这时键位由本地候选数算出来，改这里不会有任何效果 -->
                                <ListBox x:Name="ExtendedKeysList"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="0"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         PreviewMouseLeftButtonDown="OnExtendedKeysMouseDown"
                                         PreviewMouseMove="OnExtendedKeysMouseMove"
                                         PreviewMouseLeftButtonUp="OnExtendedKeysMouseUp"
                                         LostMouseCapture="OnExtendedKeysLostCapture">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="32"
                                                    Margin="0,0,0,6"
                                                    Padding="8,0"
                                                    Background="{DynamicResource ControlFillBrush}"
                                                    BorderBrush="{DynamicResource ControlStrokeBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="⋮⋮"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,10,0"
                                                               Cursor="SizeAll"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Label}"
                                                               VerticalAlignment="Center"
                                                               FontWeight="SemiBold" />

                                                    <Button Grid.Column="2"
                                                            Content="✕"
                                                            Width="24"
                                                            Height="24"
                                                            Padding="0"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                            ToolTip="移除这个键"
                                                            Click="OnRemoveExtendedKeyClick" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <ui:KeyCaptureBox x:Name="AddExtendedKeyBox"
                                                  Placeholder="＋ 添加按键"
                                                  ClearAfterCapture="True"
                                                  KeyCaptured="OnAddExtendedKeyCaptured"
                                                  Margin="0,2,0,0" />

                                <fl:TextBlock x:Name="ExtendedKeysLockedHint"
                                              Visibility="Collapsed"
                                              FontTypography="Caption"
                                              TextWrapping="Wrap"
                                              Margin="0,6,0,0"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                              Text="自动模式由本地候选数决定采纳键，上面这些键不生效；想让它们生效，请把「键位分配」改成手动指定。" />
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </Border>

                <fl:TextBlock Text="展示" FontTypography="BodyStrong" Margin="0,20,0,8" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <HeaderedContentControl Style="{StaticResource SettingRow}"
                                                Header="浮窗位置">
                            <ComboBox x:Name="PlacementComboBox" Width="160">
                                <ComboBoxItem Content="候选窗下方" Tag="Below" />
                                <ComboBoxItem Content="候选窗左侧" Tag="Left" />
                            </ComboBox>
                        </HeaderedContentControl>

                        <HeaderedContentControl Style="{StaticResource SettingRow}"
                                                Header="浮窗样式">
                            <ComboBox x:Name="PopupStyleComboBox" Width="160">
                                <ComboBoxItem Content="纯白卡片" Tag="Card" />
                                <ComboBoxItem Content="亚克力" Tag="Acrylic" />
                            </ComboBox>
                        </HeaderedContentControl>

                        <HeaderedContentControl Style="{StaticResource SettingRow}"
                                                Header="浮窗显示云图标"
                                                ui:SettingRow.ShowDivider="False">
                            <fl:ToggleSwitch x:Name="ShowCloudIconCheckBox"
                                             AutomationProperties.Name="浮窗显示云图标" />
                        </HeaderedContentControl>
                    </StackPanel>
                </Border>

                <fl:TextBlock Text="触发" FontTypography="BodyStrong" Margin="0,20,0,8" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <HeaderedContentControl Style="{StaticResource SettingRow}"
                                                Header="英文状态下也联想"
                                                ui:SettingRow.Description="默认关闭。开启后，在微软拼音的英文状态打拼音也会出候选；采纳时会先删掉已输入的字母，删除前会校验文本确实是刚输入的内容，校验不通过则放弃。">
                            <fl:ToggleSwitch x:Name="EnglishCheckBox"
                                             AutomationProperties.Name="英文状态下也联想" />
                        </HeaderedContentControl>

                        <HeaderedContentControl Style="{StaticResource SettingRow}"
                                                Header="英文模式采纳">
                            <ComboBox x:Name="EnglishCommitComboBox" Width="220">
                                <ComboBoxItem Content="删除已输入字母后上屏" Tag="Replace" />
                                <ComboBoxItem Content="仅提示，不上屏" Tag="Preview" />
                            </ComboBox>
                        </HeaderedContentControl>

                        <HeaderedContentControl Style="{StaticResource SettingRow}"
                                                Header="最小输入长度">
                            <TextBox x:Name="MinLengthTextBox" Width="100" />
                        </HeaderedContentControl>

                        <HeaderedContentControl Style="{StaticResource SettingRow}"
                                                Header="停手等待（毫秒）"
                                                ui:SettingRow.Description="停止输入后等待这么久再发请求。太短会浪费请求，太长会让用户觉得慢。">
                            <TextBox x:Name="DebounceTextBox" Width="100" />
                        </HeaderedContentControl>

                        <HeaderedContentControl Style="{StaticResource SettingRow}"
                                                Header="请求超时（毫秒）"
                                                ui:SettingRow.ShowDivider="False">
                            <TextBox x:Name="TimeoutTextBox" Width="100" />
                        </HeaderedContentControl>
                    </StackPanel>
                </Border>

                <fl:TextBlock Text="输入方式" FontTypography="BodyStrong" Margin="0,20,0,8" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <HeaderedContentControl Style="{StaticResource SettingRow}"
                                                Header="按模糊音校验读音"
                                                ui:SettingRow.Description="z/zh、n/l、前后鼻音等按同一类处理，与微软拼音的模糊音设置保持一致。">
                            <fl:ToggleSwitch x:Name="FuzzyCheckBox"
                                             AutomationProperties.Name="按模糊音校验读音" />
                        </HeaderedContentControl>

                        <HeaderedContentControl Style="{StaticResource SettingRow}"
                                                Header="使用双拼"
                                                ui:SettingRow.Description="开启后按键串不是全拼，云联想会自动停用。"
                                                ui:SettingRow.ShowDivider="False">
                            <fl:ToggleSwitch x:Name="DoublePinyinCheckBox"
                                             AutomationProperties.Name="使用双拼" />
                        </HeaderedContentControl>
                    </StackPanel>
                </Border>

                <fl:TextBlock Text="不联想的程序" FontTypography="BodyStrong" Margin="0,20,0,8" />
                <Border Style="{StaticResource Card}">
                    <HeaderedContentControl Style="{StaticResource SettingRow}"
                                            Header="进程名"
                                            ui:SettingRow.Description="不含 .exe，用逗号或换行分隔，例如 mstsc, game。"
                                            ui:SettingRow.ShowDivider="False">
                        <TextBox x:Name="BlockedTextBox" Width="240" Height="88"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" />
                    </HeaderedContentControl>
                </Border>

                <fl:TextBlock Text="运行诊断" FontTypography="BodyStrong" Margin="0,20,0,8" />
                <Border Style="{StaticResource Card}" Padding="12">
                    <TextBox x:Name="DiagnosticsTextBox" Height="170" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" />
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Page>
