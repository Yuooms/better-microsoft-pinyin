<UserControl x:Class="BetterPinyin.App.Features.CloudAssist.Views.CloudAssistPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock Text="云联想" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="当微软拼音的候选里没有你想要的词时，把 Bing 的联想结果作为补充候选提供出来。原有候选、快捷键与上屏逻辑完全不受影响。" />

            <TextBlock Text="开关" Style="{StaticResource SectionTitle}" />
            <CheckBox x:Name="EnabledCheckBox" Content="启用云联想" />
            <TextBlock Style="{StaticResource Hint}" Margin="24,-2,0,8"
                       Text="关闭后不监听按键、不发任何网络请求。" />
            <CheckBox x:Name="DoublePinyinCheckBox" Content="我使用双拼（自动停用云联想）" />
            <TextBlock Style="{StaticResource Hint}" Margin="24,-2,0,8"
                       Text="双拼下按键串不是全拼，无法还原读音，因此该功能会保持停用。" />

            <TextBlock Text="展示与采纳" Style="{StaticResource SectionTitle}" />
            <Grid Margin="0,2,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="采纳键" VerticalAlignment="Center" />
                <ComboBox x:Name="AcceptKeyComboBox" Grid.Column="1">
                    <ComboBoxItem Content="Tab" Tag="Tab" />
                    <ComboBoxItem Content="分号 ;" Tag="Semicolon" />
                    <ComboBoxItem Content="反引号 `" Tag="Backquote" />
                    <ComboBoxItem Content="逗号 ," Tag="Comma" />
                </ComboBox>
            </Grid>
            <TextBlock Style="{StaticResource Hint}" Margin="0,-2,0,10"
                       Text="仅当浮窗出现时该键才被云候选占用，其余时候行为与原来一致。" />

            <CheckBox x:Name="ShowCloudIconCheckBox" Content="在浮窗上显示云图标" />

            <TextBlock Text="触发与网络" Style="{StaticResource SectionTitle}" />
            <Grid Margin="0,2,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition Height="38" />
                    <RowDefinition Height="38" />
                    <RowDefinition Height="38" />
                </Grid.RowDefinitions>

                <TextBlock Text="最小输入长度" VerticalAlignment="Center" />
                <TextBox x:Name="MinLengthTextBox" Grid.Column="1" Width="96" Height="28"
                         HorizontalAlignment="Left" VerticalAlignment="Center" />

                <TextBlock Grid.Row="1" Text="停手等待（毫秒）" VerticalAlignment="Center" />
                <TextBox x:Name="DebounceTextBox" Grid.Row="1" Grid.Column="1" Width="96" Height="28"
                         HorizontalAlignment="Left" VerticalAlignment="Center" />

                <TextBlock Grid.Row="2" Text="请求超时（毫秒）" VerticalAlignment="Center" />
                <TextBox x:Name="TimeoutTextBox" Grid.Row="2" Grid.Column="1" Width="96" Height="28"
                         HorizontalAlignment="Left" VerticalAlignment="Center" />

                <TextBlock Grid.Row="3" Text="最多显示条数" VerticalAlignment="Center" />
                <ComboBox x:Name="MaxSuggestionsComboBox" Grid.Row="3" Grid.Column="1" Width="96" Height="28"
                          HorizontalAlignment="Left" VerticalAlignment="Center">
                    <ComboBoxItem Content="1" Tag="1" />
                    <ComboBoxItem Content="2" Tag="2" />
                    <ComboBoxItem Content="3" Tag="3" />
                </ComboBox>
            </Grid>
            <CheckBox x:Name="FuzzyCheckBox" Content="按模糊音规则校验读音" />
            <TextBlock Style="{StaticResource Hint}" Margin="24,-2,0,10"
                       Text="你的微软拼音已开启模糊音时建议保持勾选，否则 zh/z、an/ang 这类输入会被误判为读音不符。" />

            <TextBlock Text="不生效的程序" Style="{StaticResource SectionTitle}" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                       Text="填写进程名（不含 .exe），用逗号分隔。在这些程序里不弹出云候选，例如远程桌面、密码管理器和游戏。" />
            <TextBox x:Name="BlockedTextBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />

            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <Button x:Name="SaveButton" Content="保存并应用" Click="OnSaveClick" />
                <TextBlock x:Name="SaveStatusText" VerticalAlignment="Center" Margin="12,0,0,0"
                           Style="{StaticResource Hint}" />
            </StackPanel>

            <TextBlock Text="运行诊断" Style="{StaticResource SectionTitle}" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                       Text="最近的处理记录，用于判断是没触发、没结果，还是被去重过滤掉了。" />
            <TextBox x:Name="DiagnosticsTextBox"
                     Height="150"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas, Microsoft YaHei UI"
                     FontSize="12"
                     Background="#F6F7F9" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
