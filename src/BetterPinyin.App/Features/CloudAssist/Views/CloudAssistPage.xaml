<UserControl x:Class="BetterPinyin.App.Features.CloudAssist.Views.CloudAssistPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="720" Margin="24,20,24,28">

            <TextBlock Text="云联想" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                       Text="输入拼音时从 Bing 取联想词。云联想严格按字数匹配，扩展云联想补充更长的词，两者可独立开关。" />

            <TextBlock Text="总开关" Style="{StaticResource SectionTitle}" />
            <CheckBox x:Name="EnabledCheckBox" Content="启用云联想" />
            <TextBlock Style="{StaticResource Hint}" Margin="22,2,0,0"
                       Text="关闭后不查询云端，但仍保留托盘图标与设置界面。" />

            <TextBlock Text="云联想（严格）" Style="{StaticResource SectionTitle}" />
            <CheckBox x:Name="StrictCheckBox" Content="启用云联想" />
            <TextBlock Style="{StaticResource Hint}" Margin="22,2,0,6"
                       Text="候选必须与输入的字数完全相等。例如 lianxiang 只会给出「联想」，不会给出「联想电脑管家」。" />

            <Grid Margin="0,2,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="采纳键" VerticalAlignment="Center" />
                <ComboBox x:Name="AcceptKeyComboBox" Grid.Column="1">
                    <ComboBoxItem Content="·（数字 1 左侧）" Tag="Oem3" />
                    <ComboBoxItem Content="Tab" Tag="Tab" />
                    <ComboBoxItem Content=";（分号）" Tag="Semicolon" />
                    <ComboBoxItem Content="\（反斜杠）" Tag="Backslash" />
                    <ComboBoxItem Content="'（单引号）" Tag="Quote" />
                    <ComboBoxItem Content="/（斜杠）" Tag="Slash" />
                </ComboBox>
            </Grid>
            <TextBlock Style="{StaticResource Hint}" Margin="150,0,0,6"
                       Text="Tab 在微软拼音里会调出 Bing 搜索，默认改用「·」。" />

            <CheckBox x:Name="StrictDedupeCheckBox" Content="候选已在本地候选里时不显示" />
            <TextBlock Style="{StaticResource Hint}" Margin="22,2,0,0"
                       Text="本地已经能选到的词不再重复展示，避免云联想没有带来新信息。" />

            <TextBlock Text="扩展云联想" Style="{StaticResource SectionTitle}" />
            <CheckBox x:Name="ExtendedCheckBox" Content="启用扩展云联想" />
            <TextBlock Style="{StaticResource Hint}" Margin="22,2,0,6"
                       Text="补充以当前拼音开头的更长词。例如 ruonawa 会补充「若娜瓦壁纸」「若娜瓦英文」。" />

            <Grid Margin="0,2,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="34" />
                    <RowDefinition Height="34" />
                </Grid.RowDefinitions>

                <TextBlock Text="显示条数" VerticalAlignment="Center" />
                <ComboBox x:Name="ExtendedCountComboBox" Grid.Column="1" Width="90" HorizontalAlignment="Left">
                    <ComboBoxItem Content="1 条" Tag="1" />
                    <ComboBoxItem Content="2 条" Tag="2" />
                    <ComboBoxItem Content="3 条" Tag="3" />
                    <ComboBoxItem Content="4 条" Tag="4" />
                </ComboBox>

                <TextBlock Grid.Row="1" Text="键位分配" VerticalAlignment="Center" />
                <ComboBox x:Name="ExtendedKeyModeComboBox" Grid.Row="1" Grid.Column="1"
                          SelectionChanged="OnKeyModeChanged">
                    <ComboBoxItem Content="自动：接在本地候选之后" Tag="Auto" />
                    <ComboBoxItem Content="手动指定" Tag="Manual" />
                </ComboBox>

                <TextBlock Grid.Row="2" Text="手动键位" VerticalAlignment="Center" />
                <TextBox x:Name="ExtendedKeysTextBox" Grid.Row="2" Grid.Column="1" Width="120"
                         HorizontalAlignment="Left" MaxLength="8" />
            </Grid>
            <TextBlock Style="{StaticResource Hint}" Margin="150,0,0,0"
                       Text="自动模式：本地候选显示 5 个时，扩展用 6/7/8；读不到候选数时退回 6/7/8 并在提交前复核。手动模式可填 1~9，最多 4 个，例如 6789。" />

            <TextBlock Text="展示" Style="{StaticResource SectionTitle}" />
            <Grid Margin="0,2,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="34" />
                </Grid.RowDefinitions>

                <TextBlock Text="浮窗位置" VerticalAlignment="Center" />
                <ComboBox x:Name="PlacementComboBox" Grid.Column="1" Width="160" HorizontalAlignment="Left">
                    <ComboBoxItem Content="候选窗下方" Tag="Below" />
                    <ComboBoxItem Content="候选窗左侧" Tag="Left" />
                </ComboBox>

                <TextBlock Grid.Row="1" Text="浮窗样式" VerticalAlignment="Center" />
                <ComboBox x:Name="PopupStyleComboBox" Grid.Row="1" Grid.Column="1" Width="160" HorizontalAlignment="Left">
                    <ComboBoxItem Content="纯白卡片" Tag="Card" />
                    <ComboBoxItem Content="亚克力" Tag="Acrylic" />
                </ComboBox>
            </Grid>

            <CheckBox x:Name="ShowCloudIconCheckBox" Content="浮窗显示云图标" />

            <TextBlock Text="触发" Style="{StaticResource SectionTitle}" />
            <CheckBox x:Name="EnglishCheckBox" Content="英文状态下也联想" />
            <TextBlock Style="{StaticResource Hint}" Margin="22,2,0,6"
                       Text="默认关闭。开启后，在微软拼音的英文状态打拼音也会出候选；采纳时会先删掉已输入的字母，删除前会校验文本确实是刚输入的内容，校验不通过则放弃。" />

            <Grid Margin="0,2,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="英文模式采纳" VerticalAlignment="Center" />
                <ComboBox x:Name="EnglishCommitComboBox" Grid.Column="1">
                    <ComboBoxItem Content="删除已输入字母后上屏" Tag="Replace" />
                    <ComboBoxItem Content="仅提示，不上屏" Tag="Preview" />
                </ComboBox>
            </Grid>

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="34" />
                    <RowDefinition Height="34" />
                </Grid.RowDefinitions>

                <TextBlock Text="最小输入长度" VerticalAlignment="Center" />
                <TextBox x:Name="MinLengthTextBox" Grid.Column="1" Width="90" HorizontalAlignment="Left" />

                <TextBlock Grid.Row="1" Text="停手等待（毫秒）" VerticalAlignment="Center" />
                <TextBox x:Name="DebounceTextBox" Grid.Row="1" Grid.Column="1" Width="90" HorizontalAlignment="Left" />

                <TextBlock Grid.Row="2" Text="请求超时（毫秒）" VerticalAlignment="Center" />
                <TextBox x:Name="TimeoutTextBox" Grid.Row="2" Grid.Column="1" Width="90" HorizontalAlignment="Left" />
            </Grid>

            <CheckBox x:Name="FuzzyCheckBox" Content="按模糊音校验读音（z/zh、n/l、前后鼻音等）" Margin="0,6,0,0" />
            <CheckBox x:Name="DoublePinyinCheckBox" Content="使用双拼（开启后自动停用云联想）" Margin="0,4,0,0" />

            <TextBlock Text="不联想的程序" Style="{StaticResource SectionTitle}" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                       Text="填写进程名（不含 .exe），用逗号或换行分隔，例如 mstsc, game" />
            <TextBox x:Name="BlockedTextBox" Height="60" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <Button x:Name="SaveButton" Content="保存并应用" Width="120" Click="OnSaveClick" />
                <TextBlock x:Name="SaveStatusText" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <TextBlock Text="运行诊断" Style="{StaticResource SectionTitle}" />
            <TextBox x:Name="DiagnosticsTextBox" Height="150" IsReadOnly="True"
                     FontFamily="Consolas" FontSize="12" Background="#F6F7F9"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
