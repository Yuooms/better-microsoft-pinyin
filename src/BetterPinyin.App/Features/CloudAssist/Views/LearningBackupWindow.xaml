<ui:FluentWindow x:Class="BetterPinyin.App.Features.CloudAssist.Views.LearningBackupWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="自学习词库备份"
                 Width="860"
                 Height="580"
                 MinWidth="720"
                 MinHeight="470"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 FontFamily="Microsoft YaHei UI, Segoe UI">

    <!--
        备份是「删词」与「恢复」的前置保障：
        每次改动前自动留一份，所以这里要能看清单、看差异、恢复、删掉。
        和词库页一样不依赖任何自研画刷，直接用 WPF-UI 的动态资源，深浅色自动跟随。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Height="44" Title="自学习词库备份" />

        <Grid Grid.Row="1" Margin="20,4,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="删除自学习词、或从备份恢复之前，程序都会先把当时的词库原样留一份。选中一份备份可以看它和现在差在哪里，再决定恢复或删除。" />

            <!-- 备份清单：表头与行模板列宽必须一致。 -->
            <Grid Grid.Row="1" Margin="0,14,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="28" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="备份时间" Style="{StaticResource Hint}" />
                    <TextBlock Grid.Column="1" Text="词条数" Style="{StaticResource Hint}" />
                    <TextBlock Grid.Column="2" Text="相对现在" Style="{StaticResource Hint}" />
                    <TextBlock Grid.Column="3" Text="大小" Style="{StaticResource Hint}" />
                </Grid>

                <ui:ListView x:Name="BackupList"
                             Grid.Row="1"
                             MaxHeight="240"
                             SelectionMode="Single"
                             SelectionChanged="OnBackupSelectionChanged"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ui:ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="34">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Time}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding WordCount}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Delta}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3"
                                           Text="{Binding Size}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ui:ListView.ItemTemplate>
                </ui:ListView>

                <TextBlock x:Name="EmptyText"
                           Grid.Row="1"
                           Visibility="Collapsed"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="520"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="还没有备份。删除或恢复自学习词之前，程序会自动在这里留一份。" />
            </Grid>

            <TextBlock x:Name="PreviewTitle"
                       Grid.Row="2"
                       Margin="0,14,0,6"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="选中一份备份查看差异" />

            <Border Grid.Row="3"
                    MinHeight="120"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CardCornerRadius}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,6">
                    <ItemsControl x:Name="DiffList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" Margin="0,1">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Missing">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Extra">
                                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="4" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:Button x:Name="RestoreButton"
                           Grid.Column="0"
                           Content="恢复到此备份"
                           Appearance="Primary"
                           IsEnabled="False"
                           Click="OnRestoreClick" />
                <ui:Button x:Name="DeleteButton"
                           Grid.Column="1"
                           Content="删除这份备份"
                           Appearance="Danger"
                           IsEnabled="False"
                           Margin="8,0,0,0"
                           Click="OnDeleteClick" />

                <TextBlock x:Name="StatusText"
                           Grid.Column="2"
                           Margin="14,0"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxHeight="44"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <ui:Button Grid.Column="3"
                           Content="关闭"
                           Click="OnCloseClick" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
