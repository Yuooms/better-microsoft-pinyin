<Page x:Class="BetterPinyin.App.Features.CloudAssist.Views.WordbookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:fl="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:ui="clr-namespace:BetterPinyin.App.Shell.Controls"
      ScrollViewer.CanContentScroll="False"
      FontFamily="Microsoft YaHei UI, Segoe UI"
      Background="Transparent">

    <!--
        三行布局：顶部搜索与筛选、中间虚拟化列表、底部统计与批量操作。
        绝对不能把列表包进外层 ScrollViewer —— 那样测量高度变成无穷大，
        VirtualizingStackPanel 会退化成全量实例化，15 万条直接把界面卡死。
    -->
    <Grid Margin="{DynamicResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" MaxWidth="1100" HorizontalAlignment="Left">
            <fl:TextBlock Text="词库" FontTypography="Title" />
            <fl:TextBlock FontTypography="Caption"
                          TextWrapping="Wrap"
                          Margin="0,4,0,0"
                          Text="采纳过的云词会自动记到这里。内置词库只读，调权重与遗忘写在本程序的覆盖层；「同步」会把词写进微软拼音的自定义短语，切换一次输入法后生效。" />

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <fl:TextBox x:Name="SearchBox"
                            Grid.Column="0"
                            PlaceholderText="搜索汉字、全拼或简拼（如 伊斯塔露 / yisita / ystl）"
                            TextChanged="OnSearchChanged" />

                <ComboBox x:Name="FilterBox"
                          Grid.Column="1"
                          Width="132"
                          Margin="10,0,0,0"
                          VerticalAlignment="Center"
                          SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="全部" Tag="All" IsSelected="True" />
                    <ComboBoxItem Content="我的词" Tag="User" />
                    <ComboBoxItem Content="已提升" Tag="Boosted" />
                    <ComboBoxItem Content="已降低" Tag="Reduced" />
                    <ComboBoxItem Content="已遗忘" Tag="Hidden" />
                    <ComboBoxItem Content="待同步" Tag="Pending" />
                </ComboBox>

                <TextBlock x:Name="CountText"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <fl:ToggleSwitch x:Name="LearnToggle"
                                 Content="采纳后自动记忆"
                                 Margin="0,0,24,0"
                                 Checked="OnToggleChanged"
                                 Unchecked="OnToggleChanged" />
                <fl:ToggleSwitch x:Name="LocalFirstToggle"
                                 Content="本地命中不联网"
                                 Margin="0,0,24,0"
                                 Checked="OnToggleChanged"
                                 Unchecked="OnToggleChanged" />
                <fl:ToggleSwitch x:Name="AutoSyncToggle"
                                 Content="空闲 3 秒自动写入输入法"
                                 Checked="OnToggleChanged"
                                 Unchecked="OnToggleChanged" />
            </StackPanel>
        </StackPanel>

        <!-- 表头：列宽必须与行模板完全一致，否则会错位。 -->
        <Grid Grid.Row="1"
              Margin="0,14,0,0"
              MaxWidth="1100"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Top"
              Height="28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="76" />
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="188" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="词" Style="{StaticResource Hint}" />
            <TextBlock Grid.Column="1" Text="拼音" Style="{StaticResource Hint}" />
            <TextBlock Grid.Column="2" Text="来源" Style="{StaticResource Hint}" />
            <TextBlock Grid.Column="3" Text="热度" Style="{StaticResource Hint}" />
            <TextBlock Grid.Column="4" Text="状态" Style="{StaticResource Hint}" />
            <TextBlock Grid.Column="5" Text="操作" Style="{StaticResource Hint}" />
        </Grid>

        <fl:ListView x:Name="RowsList"
                     Grid.Row="1"
                     Margin="0,28,0,0"
                     MaxWidth="1100"
                     HorizontalAlignment="Stretch"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <fl:ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Height="38">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="188" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding Text}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Pinyin}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Source}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="3"
                                   Text="{Binding Heat}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="4"
                                   Text="{Binding StateText}"
                                   VerticalAlignment="Center" />

                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="提升" Tag="{Binding}" Click="OnBoostClick" Padding="8,2" MinWidth="40" />
                            <Button Content="降低" Tag="{Binding}" Click="OnReduceClick" Padding="8,2" MinWidth="40" Margin="4,0,0,0" />
                            <Button Content="遗忘" Tag="{Binding}" Click="OnHideClick" Padding="8,2" MinWidth="40" Margin="4,0,0,0" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </fl:ListView.ItemTemplate>
        </fl:ListView>

        <StackPanel Grid.Row="2" Margin="0,12,0,0" MaxWidth="1100" HorizontalAlignment="Left">
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="12"
                    Visibility="Collapsed"
                    x:Name="AddPanel">
                <StackPanel Orientation="Horizontal">
                    <fl:TextBox x:Name="AddWordBox" Width="180" PlaceholderText="词，如 伊斯塔露" />
                    <fl:TextBox x:Name="AddPinyinBox" Width="200" Margin="8,0,0,0" PlaceholderText="拼音，如 yisitalu" />
                    <fl:TextBox x:Name="AddPositionBox" Width="70" Margin="8,0,0,0" PlaceholderText="位置" />
                    <fl:Button Content="添加" Appearance="Primary" Margin="8,0,0,0" Click="OnAddConfirmClick" />
                    <fl:Button Content="取消" Margin="8,0,0,0" Click="OnAddCancelClick" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <fl:Button Content="添加词条" Click="OnAddClick" />
                <fl:Button Content="同步到微软拼音" Appearance="Primary" Margin="8,0,0,0" Click="OnSyncClick" />
                <fl:Button Content="导入" Margin="8,0,0,0" Click="OnImportClick" />
                <fl:Button Content="导出" Margin="8,0,0,0" Click="OnExportClick" />
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           TextWrapping="Wrap"
                           MaxWidth="460"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
