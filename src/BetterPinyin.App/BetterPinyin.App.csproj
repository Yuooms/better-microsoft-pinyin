<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>BetterPinyin.App</RootNamespace>
    <AssemblyName>BetterMicrosoftPinyin</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFAC010：WinForms 分析器要求用 SetHighDpiMode 配置 DPI。
         本程序是 WPF 主导，而且浮窗定位依赖清单里的 PerMonitorV2 声明，
         因此保留清单配置并屏蔽该提示。 -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <Description>为微软拼音提供云联想的伴随程序。</Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      同时启用 WPF 与 WinForms 时，SDK 会为两者都注入全局 using，
      导致 Application / UserControl / Brush / ComboBox 等类型二义。
      这里移除 WinForms 的全局导入，只有托盘图标那个文件显式引入它。
    -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!--
      设置窗口的 Fluent 控件、导航与标题栏。MIT 许可，版权声明见 THIRD-PARTY-NOTICES.md。
      候选浮窗不使用它：无焦点、点击穿透的窗口 WPF-UI 接管不了。
    -->
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BetterPinyin.Contracts\BetterPinyin.Contracts.csproj" />
    <ProjectReference Include="..\BetterPinyin.Core\BetterPinyin.Core.csproj" />
    <ProjectReference Include="..\BetterPinyin.Interop\BetterPinyin.Interop.csproj" />
  </ItemGroup>

</Project>
