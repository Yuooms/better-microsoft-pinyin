<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>BetterPinyin.Core</RootNamespace>
    <AssemblyName>BetterPinyin.Core</AssemblyName>
    <Description>业务核心：云联想查询、拼音校验、排序、缓存、设置与功能模块框架。不得引用任何 UI 或 Win32。</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BetterPinyin.Contracts\BetterPinyin.Contracts.csproj" />
  </ItemGroup>

  <!-- 内置词库随程序输出。文件由 tools/LexiconBuilder 生成，见 docs/LEXICON.md。 -->
  <ItemGroup Condition="Exists('..\..\assets\lexicon.bin')">
    <Content Include="..\..\assets\lexicon.bin" Link="lexicon.bin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
